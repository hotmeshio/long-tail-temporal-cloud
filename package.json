{
  "name": "long-tail-temporal-cloud",
  "version": "0.1.1",
  "private": true,
  "description": "Long Tail on Temporal Cloud: a workflow advertises fabrication work a factory site pulls, does and resolves.",
  "license": "MIT",
  "main": "build/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config tests/integration/vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "site-key": "tsx scripts/mint-site-key.ts",
    "smoke": "tsx scripts/smoke-handoff.ts"
  },
  "dependencies": {
    "@hotmeshio/long-tail": "^0.38.0",
    "@hotmeshio/long-tail-temporal": "^0.5.2",
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/common": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
