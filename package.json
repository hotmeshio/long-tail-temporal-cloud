{
  "name": "long-tail-temporal-cloud",
  "version": "0.2.1",
  "private": true,
  "description": "Long Tail on Temporal Cloud: the Acme Eyeglass order, from prescription review through production at a factory site to the carrier pickup.",
  "license": "MIT",
  "main": "build/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config tests/integration/vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "site-key": "tsx scripts/mint-site-key.ts",
    "smoke": "tsx scripts/smoke-handoff.ts",
    "seed:story": "tsx scripts/seed-story.ts",
    "make:pdf": "tsx scripts/make-prescription-pdf.ts"
  },
  "dependencies": {
    "@hotmeshio/long-tail": "^0.39.0",
    "@hotmeshio/long-tail-temporal": "^0.5.4",
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/common": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
