# Copy to .env. Every value here is a local default; docker compose supplies
# the same defaults, so an empty .env runs the stack with a self-hosted Temporal.

# api | worker | both. One container runs both locally; AWS runs one of each.
APP_ROLE=both
APP_PORT=3600

# Temporal. For Temporal Cloud set the namespace's regional address, the
# namespace id (name.account) and an API key; the connection then uses TLS.
# TEMPORAL_ADDRESS=us-east-1.aws.api.temporal.io:7233
# TEMPORAL_NAMESPACE=my-namespace.a1b2c
# TEMPORAL_API_KEY=
# TEMPORAL_UI_URL=https://cloud.temporal.io

# Long Tail
JWT_SECRET=local-dev-secret
LT_ADMIN_USER=superadmin
LT_ADMIN_PASSWORD=l0ngt@1l

# The worker's key for the Long Tail API. With LT_API_KEY unset, the worker
# signs in as the admin at boot and mints one.
# LT_URL=http://localhost:3000
# LT_API_KEY=

# Storage. Signed links are issued against the public endpoint.
# LT_S3_PUBLIC_ENDPOINT=http://host.docker.internal:9702
